// 자습실 예약 MVP 스키마
// 설계 근거: issues/002-db-schema/README.md 결정 기록, 규칙: CLAUDE.md 5·6절

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

/// 신청 레코드의 현재 상태
enum VisitStatus {
  ACTIVE
  CANCELED
}

/// 이력에 남는 행위 종류
enum VisitAction {
  /// 최초 신청
  APPLIED
  /// 취소 후 재신청 (R3)
  REAPPLIED
  /// 방문 시간 수정
  TIME_CHANGED
  /// 학생 본인 취소
  CANCELED
  /// 자습실·학생 삭제로 인한 자동 취소 (R8, R9)
  SYSTEM_CANCELED
}

/// 행위 주체
enum ActorType {
  STUDENT
  TEACHER
  SYSTEM
}

model Student {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft Delete. null이면 활성 학생
  deletedAt DateTime?

  visits    Visit[]
  histories VisitHistory[]

  @@index([deletedAt])
  @@map("students")
}

model StudyRoom {
  id           Int       @id @default(autoincrement())
  /// 목록에서 자습실을 구분하기 위한 이름 (과제 필수 엔티티 외 추가 필드)
  title        String
  maxPersonnel Int
  /// 활성 신청 수 (비정규화). 정원 검사를 조건부 원자적 UPDATE 한 번으로 하기 위해 둔다.
  /// VisitsService(와 삭제 처리)만 변경한다. CLAUDE.md 7절
  activeCount  Int       @default(0)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Soft Delete. null이면 운영 중
  deletedAt    DateTime?

  visits    Visit[]
  histories VisitHistory[]

  @@index([deletedAt])
  @@map("study_rooms")
}

/// 방문 신청의 현재 상태 스냅샷. (자습실, 학생)당 정확히 한 행이다.
/// 취소 후 재신청은 새 행을 만들지 않고 이 행을 다시 ACTIVE로 바꾼다 (R3).
model Visit {
  id        Int         @id @default(autoincrement())
  roomId    Int
  studentId Int
  visitAt   DateTime
  status    VisitStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  room      StudyRoom      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  histories VisitHistory[]

  /// 중복 신청을 애플리케이션이 아니라 DB가 막는다
  @@unique([roomId, studentId])
  /// "내 신청 목록" 조회
  @@index([studentId, status])
  /// 자습실 수정 시 활성 신청 검사 (R6, R7)
  @@index([roomId, status])
  @@map("visits")
}

/// 신청 변경 이력. append-only: INSERT만 하고 UPDATE·DELETE 하지 않는다.
model VisitHistory {
  id          Int         @id @default(autoincrement())
  visitId     Int
  /// 비정규화: 자습실 상세 이력 조회 시 JOIN 제거. 이력은 불변이라 불일치가 생기지 않는다.
  roomId      Int
  studentId   Int
  action      VisitAction
  actorType   ActorType
  /// 변경 전 방문 시각 (최초 신청이면 null)
  prevVisitAt DateTime?
  /// 변경 후 방문 시각 (취소면 null)
  nextVisitAt DateTime?
  /// 시스템 취소 사유 등
  reason      String?
  createdAt   DateTime    @default(now())

  visit   Visit     @relation(fields: [visitId], references: [id], onDelete: Restrict)
  room    StudyRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  /// FR-ROM-03: 자습실별 이력 시간순 조회
  @@index([roomId, createdAt])
  @@index([visitId, createdAt])
  @@map("visit_histories")
}
